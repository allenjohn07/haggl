# Copy to .env.local and fill in. Never commit real values: this repo is public.

# --- AI ---
ANTHROPIC_API_KEY=
# mock = scripted debates, free; live = real Claude calls (use for testing the real thing and the demo)
AI_MODE=mock
AI_MODEL=claude-haiku-5-5

# --- Channel3 (product search and prices) ---
CHANNEL3_API_KEY=
# mock = saved fixtures in data/fixtures, free; live = real Channel3 search
SEARCH_MODE=mock

# --- PayPal (SANDBOX ONLY) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# --- App ---
# Used for PayPal return and cancel URLs. Set to the Render URL in production.
APP_URL=http://localhost:3000
